# Frontend (Vite) API URL. For local development use http://localhost:10000
VITE_API_URL=http://localhost:10000

# Backend
NODE_ENV=development
PORT=10000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=NutriGram Administrator
# Generate this using: node server/scripts/hash-password.js "Your-long-password"
ADMIN_PASSWORD_HASH=replace-with-salt-colon-hash
# Comma-separated exact frontend origins
FRONTEND_URL=http://localhost:3000
